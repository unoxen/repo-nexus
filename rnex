#!/bin/sh
# shellcheck shell=sh
# ============================================================================
# rnex — Repo Nexus CLI
# Lightweight zero-dependency Virtual Meta-Repo companion for multi-repo
# workspaces and shared AI context (no git submodules).
# Pure POSIX shell compatible (/bin/sh).
# ============================================================================
set -e

# Resolve location of this script (follows symlinks)
resolve_script_path() {
  _source="$1"
  while [ -L "$_source" ]; do
    _dir="$(cd "$(dirname "$_source")" 2>/dev/null && pwd -P)"
    _source="$(readlink "$_source")"
    case "$_source" in
      /*) ;;
      *)  _source="$_dir/$_source" ;;
    esac
  done
  cd "$(dirname "$_source")" 2>/dev/null && pwd -P
}

SCRIPT_LOCATION="$(resolve_script_path "$0")"

# Locate lib directory
find_lib_dir() {
  if [ -n "$RNEX_LIB_DIR" ] && [ -d "$RNEX_LIB_DIR" ]; then
    printf '%s' "$RNEX_LIB_DIR"
    return 0
  fi
  _sdir="$(dirname "$SCRIPT_LOCATION")"
  for _cand in "$SCRIPT_LOCATION/lib" "$_sdir/lib" "$_sdir/../lib"; do
    if [ -d "$_cand" ]; then
      printf '%s' "$_cand"
      return 0
    fi
  done
  return 1
}

RNEX_LIB_DIR="$(find_lib_dir || true)"
if [ -z "$RNEX_LIB_DIR" ]; then
  printf '\033[0;31m[✗]\033[0m Could not locate rnex library directory (lib/)\n' >&2
  exit 1
fi

# Load modules
. "$RNEX_LIB_DIR/core.sh"
. "$RNEX_LIB_DIR/yaml.sh"
. "$RNEX_LIB_DIR/workspace.sh"
. "$RNEX_LIB_DIR/repos.sh"
. "$RNEX_LIB_DIR/plugins.sh"
. "$RNEX_LIB_DIR/sdk.sh"
. "$RNEX_LIB_DIR/ai.sh"
. "$RNEX_LIB_DIR/hooks.sh"
. "$RNEX_LIB_DIR/commands.sh"

# ============================================================================
# Entry Point & Option Parsing
# ============================================================================

# Global configuration override path (set via --config, -c, or RNEX_CONFIG env var)
CUSTOM_CONFIG=""
[ -n "$RNEX_CONFIG" ] && CUSTOM_CONFIG="$RNEX_CONFIG"

# Parse global options (--config / -c) while preserving all other arguments in order
ORIG_COUNT=$#
i=0
while [ "$i" -lt "$ORIG_COUNT" ]; do
  i=$((i + 1))
  case "$1" in
    --config=*)
      CUSTOM_CONFIG="${1#*=}"
      shift
      ;;
    --config|-c)
      [ -n "$2" ] || die "Option $1 requires a file path argument"
      CUSTOM_CONFIG="$2"
      shift 2
      i=$((i + 1))
      ;;
    *)
      _arg="$1"
      shift
      set -- "$@" "$_arg"
      ;;
  esac
done

# Export workspace root and repos directory variables if inside a workspace
_ws_cand=""
if [ -n "$CUSTOM_CONFIG" ]; then
  _cfg_p="$(resolve_path "$CUSTOM_CONFIG" 2>/dev/null || true)"
  [ -f "$_cfg_p" ] && _ws_cand="$(cd -P "$(dirname "$_cfg_p")" 2>/dev/null && pwd -P)"
elif [ -f rnex.yaml ]; then
  _ws_cand="$PWD"
else
  _ws_cand="$(find_workspace_dir 2>/dev/null || true)"
fi
if [ -n "$_ws_cand" ]; then
  NEXUS_DIR="${NEXUS_DIR:-$_ws_cand}"
  RNEX_ROOT="${RNEX_ROOT:-$_ws_cand}"
  export NEXUS_DIR RNEX_ROOT
  _yaml_resolve_files
  REPOS_DIR_REL="$(yaml_get_repos_dir)"
  REPOS_DIR="$(get_repos_root)"
  export REPOS_DIR_REL REPOS_DIR
fi

# Pre-flight auto-sync: reconcile workspace if configuration changed on disk
case "${1:-help}" in
  list|exec|clone|repo|plugin)
    auto_sync_if_needed
    ;;
esac

# Execute action wrapped in before_<action> and after_<action> lifecycle hooks
dispatch_action() {
  _action="$1"
  shift
  run_hook "before_$_action" "$@"
  set +e
  case "$_action" in
    init)        cmd_init "$@" ;;
    install)     cmd_install "$@" ;;
    repo)        cmd_repo "$@" ;;
    clone)       cmd_clone "$@" ;;
    exec)        cmd_exec "$@" ;;
    sync)        cmd_sync "$@" ;;
    plugin)      cmd_plugin "$@" ;;
    *)           die "Unknown action: $_action" ;;
  esac
  _rc=$?
  set -e
  run_hook "after_$_action" "$@"
  return $_rc
}

# Subcommand routing table
case "${1:-help}" in
  _hook)
    shift
    run_git_hook "$@"
    exit $?
    ;;
  init|install|repo|clone|exec|sync|plugin)
    _cmd="$1"
    shift
    dispatch_action "$_cmd" "$@"
    exit $?
    ;;
  list)        shift; cmd_list "$@" ;;
  status)      shift; cmd_status "$@" ;;
  completion)  shift; cmd_completion "$@" ;;
  version|-v|--version) cmd_version ;;
  help|-h|--help) cmd_help ;;
  *)           die "Unknown command: $1 (try 'rnex help')" ;;
esac
