#!/bin/sh
# ============================================================================
# rnex — Repo Nexus CLI
# Lightweight zero-dependency Virtual Meta-Repo companion for multi-repo
# workspaces and shared AI context (no git submodules).
# Pure POSIX shell compatible (/bin/sh).
# ============================================================================
set -e

# Resolve location of this script (follows symlinks)
resolve_script_path() {
  _source="$1"
  while [ -L "$_source" ]; do
    _dir="$(cd "$(dirname "$_source")" 2>/dev/null && pwd -P)"
    _source="$(readlink "$_source")"
    case "$_source" in
      /*) ;;
      *)  _source="$_dir/$_source" ;;
    esac
  done
  cd "$(dirname "$_source")" 2>/dev/null && pwd -P
}

SCRIPT_LOCATION="$(resolve_script_path "$0")"

# Locate lib directory
find_lib_dir() {
  if [ -n "$RNEX_LIB_DIR" ] && [ -d "$RNEX_LIB_DIR" ]; then
    printf '%s' "$RNEX_LIB_DIR"
    return 0
  fi
  _sdir="$(dirname "$SCRIPT_LOCATION")"
  for _cand in "$SCRIPT_LOCATION/lib" "$_sdir/lib" "$_sdir/../lib"; do
    if [ -d "$_cand" ]; then
      printf '%s' "$_cand"
      return 0
    fi
  done
  return 1
}

RNEX_LIB_DIR="$(find_lib_dir || true)"
if [ -z "$RNEX_LIB_DIR" ]; then
  printf '\033[0;31m[✗]\033[0m Could not locate rnex library directory (lib/)\n' >&2
  exit 1
fi

# Load modules
. "$RNEX_LIB_DIR/core.sh"
. "$RNEX_LIB_DIR/workspace.sh"
. "$RNEX_LIB_DIR/yaml.sh"
. "$RNEX_LIB_DIR/repos.sh"
. "$RNEX_LIB_DIR/plugins.sh"
. "$RNEX_LIB_DIR/ai.sh"
. "$RNEX_LIB_DIR/hooks.sh"
. "$RNEX_LIB_DIR/commands.sh"

# ============================================================================
# Entry Point & Option Parsing
# ============================================================================

CUSTOM_CONFIG=""
[ -n "$RNEX_CONFIG" ] && CUSTOM_CONFIG="$RNEX_CONFIG"

ORIG_COUNT=$#
i=0
while [ "$i" -lt "$ORIG_COUNT" ]; do
  i=$((i + 1))
  case "$1" in
    --config=*)
      CUSTOM_CONFIG="${1#*=}"
      shift
      ;;
    --config|-c)
      [ -n "$2" ] || die "Option $1 requires a file path argument"
      CUSTOM_CONFIG="$2"
      shift 2
      i=$((i + 1))
      ;;
    *)
      _arg="$1"
      shift
      set -- "$@" "$_arg"
      ;;
  esac
done

case "${1:-help}" in
  init)        shift; cmd_init "$@" ;;
  install)     shift; cmd_install "$@" ;;
  add)         shift; cmd_add "$@" ;;
  clone)       shift; cmd_clone "$@" ;;
  exec)        shift; cmd_exec "$@" ;;
  remove)      shift; cmd_remove "$@" ;;
  enable)      shift; cmd_enable "$@" ;;
  disable)     shift; cmd_disable "$@" ;;
  show)        shift; cmd_show "$@" ;;
  hide)        shift; cmd_hide "$@" ;;
  list)        shift; cmd_list "$@" ;;
  status)      shift; cmd_status "$@" ;;
  hooks)       shift; cmd_hooks "$@" ;;
  update|upgrade) shift; cmd_update "$@" ;;
  rnex-dir)    shift; cmd_rnex_dir "$@" ;;
  sync)        shift; cmd_sync "$@" ;;
  fix)         shift; cmd_fix "$@" ;;
  plugin)      shift; cmd_plugin "$@" ;;
  completion)  shift; cmd_completion "$@" ;;
  version|-v|--version) cmd_version ;;
  help|-h|--help) cmd_help ;;
  *)           die "Unknown command: $1 (try 'rnex help')" ;;
esac
