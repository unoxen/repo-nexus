{
  "name": "repo-nexus",
  "version": "0.6.3",
  "description": "Lightweight, zero-dependency Virtual Meta-Repo companion for multi-repo workspaces and shared AI context (no git submodules)",
  "bin": {
    "repo-nexus": "rnex",
    "rnex": "rnex"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "test": "./tests/test_cli.sh",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "files": [
    "rnex",
    "lib/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/",
    "!docs/.vitepress/",
    "toolkit/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unoxen/repo-nexus.git"
  },
  "bugs": {
    "url": "https://github.com/unoxen/repo-nexus/issues"
  },
  "homepage": "https://github.com/unoxen/repo-nexus#readme",
  "keywords": [
    "rnex",
    "repo-nexus",
    "multi-repo",
    "monorepo",
    "meta-repo",
    "harness",
    "workspace",
    "toolkit",
    "ai-agents",
    "agents.md",
    "cursor-rules",
    "claude-code",
    "copilot",
    "cursor",
    "plugins",
    "karpathy",
    "context-engineering",
    "developer-tools",
    "cli"
  ],
  "license": "MIT",
  "author": "Anton Shramkov",
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "devDependencies": {
    "vitepress": "^1.6.0"
  }
}
