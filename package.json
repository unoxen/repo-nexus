{
  "name": "repo-nexus",
  "version": "0.8.20",
  "description": "Lightweight, zero-dependency Virtual Meta Repository (meta repo) and Nexus Repository (nexus repo) manager for multi-repo workspaces and shared AI context (no git submodules)",
  "bin": {
    "repo-nexus": "rnex",
    "rnex": "rnex"
  },
  "scripts": {
    "prepare": "git config core.hooksPath scripts/githooks 2>/dev/null || true",
    "version": "./scripts/sync-plugin-versions.sh && git add toolkit/plugins/*/plugin.yaml",
    "test": "./tests/test_cli.sh",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "files": [
    "rnex",
    "lib/",
    "templates/",
    "toolkit/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unoxen/repo-nexus.git"
  },
  "bugs": {
    "url": "https://github.com/unoxen/repo-nexus/issues"
  },
  "homepage": "https://unoxen.github.io/repo-nexus/",
  "keywords": [
    "nexus repository",
    "meta repository",
    "nexus repo",
    "meta repo",
    "virtual meta-repo",
    "virtual meta repository",
    "multi-repo",
    "repo-nexus",
    "rnex",
    "ai-context",
    "context-repository",
    "agents-md",
    "ai-agents",
    "cursor-rules",
    "claude-code",
    "copilot",
    "developer-tools"
  ],
  "license": "Apache-2.0",
  "author": "Anton Shramkov",
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "devDependencies": {
    "mermaid": "^11.17.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "vite": "^6.4.4"
  }
}
