{
  "name": "repo-nexus",
  "version": "0.7.27",
  "description": "Lightweight, zero-dependency Virtual Meta-Repo companion for multi-repo workspaces and shared AI context (no git submodules)",
  "bin": {
    "repo-nexus": "rnex",
    "rnex": "rnex"
  },
  "scripts": {
    "prepare": "git config core.hooksPath scripts/githooks 2>/dev/null || true",
    "test": "./tests/test_cli.sh",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "files": [
    "rnex",
    "lib/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/",
    "!docs/.vitepress/",
    "toolkit/",
    "templates/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unoxen/repo-nexus.git"
  },
  "bugs": {
    "url": "https://github.com/unoxen/repo-nexus/issues"
  },
  "homepage": "https://unoxen.github.io/repo-nexus/",
  "keywords": [
    "rnex",
    "repo-nexus",
    "virtual-meta-repo",
    "meta-repo",
    "multi-repo",
    "agents-md",
    "ai-agents",
    "cursor-rules",
    "claude-code",
    "copilot",
    "developer-tools"
  ],
  "license": "MIT",
  "author": "Anton Shramkov",
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "devDependencies": {
    "vitepress": "^1.6.0"
  }
}
