#!/bin/sh
# shellcheck shell=sh
set -e

# Ensure standard user & package manager bin directories are in PATH (for GUI Git clients on macOS/Linux)
for _p in /opt/homebrew/bin /usr/local/bin "$HOME/.nvm/current/bin" "$HOME/.volta/bin" "$HOME/.asdf/shims"; do
  if [ -d "$_p" ] && case ":$PATH:" in *":$_p:"*) false;; *) true;; esac; then
    PATH="$_p:$PATH"
  fi
done
export PATH

# Skip version bump if explicitly disabled via environment variable
if [ -n "$SKIP_VERSION_BUMP" ]; then
  exit 0
fi

# Find package.json in the repository root
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
PKG_JSON="$REPO_ROOT/package.json"

if [ ! -f "$PKG_JSON" ]; then
  exit 0
fi

# Do not bump if nothing is staged in git
if git diff --cached --quiet; then
  exit 0
fi

# Synchronize version across all built-in toolkit plugin manifests
sync_toolkit_plugin_versions() {
  _target_ver="$1"
  [ -n "$_target_ver" ] || return 0
  for _manifest in "$REPO_ROOT"/toolkit/plugins/*/plugin.yaml; do
    [ -f "$_manifest" ] || continue
    _tmp_m="$_manifest.tmp.$$"
    sed "s/^version:[ ].*/version: $_target_ver/" "$_manifest" > "$_tmp_m" && mv "$_tmp_m" "$_manifest"
    git add "$_manifest"
  done
}

# If package.json top-level semver version was already explicitly bumped in the staged diff,
# ensure all plugin manifests match and do not bump again.
# Matches: '+' followed by whitespace, '"version"', ':', and a semver starting with a digit.
# This prevents falsely matching script keys (e.g. "version": "./scripts/...") or dependency changes.
if git diff --cached "$PKG_JSON" 2>/dev/null | grep -q '^[+][ ]*"version"[ ]*:[ ]*"[0-9]'; then
  CUR_VERSION="$(awk '/^[ ]*"version"[ ]*:[ ]*"[0-9]/ { sub(/.*"version"[ ]*:[ ]*"/, ""); sub(/".*/, ""); print; exit }' "$PKG_JSON")"
  if [ -n "$CUR_VERSION" ]; then
    sync_toolkit_plugin_versions "$CUR_VERSION"
    GIT_DIR="$(git rev-parse --git-dir 2>/dev/null || echo "$REPO_ROOT/.git")"
    printf 'v%s\n' "$CUR_VERSION" > "$GIT_DIR/PENDING_VERSION_TAG"
  fi
  exit 0
fi

if ! command -v npm >/dev/null 2>&1; then
  exit 0
fi

# Increment patch version without creating a git tag in pre-commit
npm version patch --no-git-tag-version >/dev/null 2>&1 || npm version patch --no-git-tag-version

# Read the newly bumped version directly from package.json (single source of truth)
NEW_VERSION="$(awk '/^[ ]*"version"[ ]*:[ ]*"[0-9]/ { sub(/.*"version"[ ]*:[ ]*"/, ""); sub(/".*/, ""); print; exit }' "$PKG_JSON")"
if [ -z "$NEW_VERSION" ]; then
  printf 'Error: Unable to extract bumped version from %s\n' "$PKG_JSON" >&2
  exit 1
fi

# Stage the updated package.json
git add "$PKG_JSON"
if [ -f "$REPO_ROOT/package-lock.json" ]; then
  git add "$REPO_ROOT/package-lock.json"
fi

# Synchronize and stage all built-in plugin manifests to match package.json version
sync_toolkit_plugin_versions "$NEW_VERSION"

# Queue version git tag to be created on the commit by post-commit hook
GIT_DIR="$(git rev-parse --git-dir 2>/dev/null || echo "$REPO_ROOT/.git")"
printf 'v%s\n' "$NEW_VERSION" > "$GIT_DIR/PENDING_VERSION_TAG"

printf '[repo-nexus] Auto-bumped patch version to %s (tag v%s queued)\n' "$NEW_VERSION" "$NEW_VERSION"
