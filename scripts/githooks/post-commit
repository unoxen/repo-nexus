#!/bin/sh
set -e

# Skip git tag creation if explicitly disabled via environment variable
if [ -n "$SKIP_GIT_TAG" ]; then
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
GIT_DIR="$(git rev-parse --git-dir 2>/dev/null || echo "$REPO_ROOT/.git")"
TAG_FILE="$GIT_DIR/PENDING_VERSION_TAG"

TAG_NAME=""
if [ -f "$TAG_FILE" ]; then
  TAG_NAME="$(cat "$TAG_FILE" 2>/dev/null | tr -d '[:space:]')"
  rm -f "$TAG_FILE"
fi

# Fallback: if package.json was bumped in HEAD without pre-commit queueing it
if [ -z "$TAG_NAME" ] && [ -f "$REPO_ROOT/package.json" ]; then
  if git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null | grep -qx "package.json"; then
    _cur_ver="$(node -p 'require("./package.json").version' 2>/dev/null || awk -F'"' '/"version"[ ]*:/ { print $4; exit }' "$REPO_ROOT/package.json")"
    if [ -n "$_cur_ver" ]; then
      TAG_NAME="v$_cur_ver"
    fi
  fi
fi

if [ -n "$TAG_NAME" ]; then
  # Only create tag if it does not already exist
  if ! git rev-parse -q --verify "refs/tags/$TAG_NAME" >/dev/null 2>&1; then
    git tag -a "$TAG_NAME" -m "Release $TAG_NAME" 2>/dev/null || git tag "$TAG_NAME"
    printf '[repo-nexus] Created git tag %s on commit %s\n' "$TAG_NAME" "$(git rev-parse --short HEAD)"
  fi
fi
